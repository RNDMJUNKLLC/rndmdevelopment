# Discord Webhook Configuration
# Webhook URLs are stored as secrets in Cloudflare Pages
# (Settings → Environment Variables). The Pages Function at
# /api/discord-webhook proxies requests server-side.
#
# Required secrets in Cloudflare:
#   VITE_DISCORD_WEBHOOK_INQUIRY = https://discord.com/api/webhooks/...
#   VITE_DISCORD_WEBHOOK_INVOICE = https://discord.com/api/webhooks/...
#   VITE_DISCORD_WEBHOOK_SOS     = https://discord.com/api/webhooks/...

# Application Configuration
VITE_APP_NAME=RNDM Development
VITE_ADMIN_EMAIL=admin@rndmdevs.com
