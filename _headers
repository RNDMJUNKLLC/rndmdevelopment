# Cache hashed assets forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache JS files for 1 hour
/*.js
  Cache-Control: public, max-age=3600

# Cache CSS files for 1 hour
/*.css
  Cache-Control: public, max-age=3600

# Cache images for 1 week
/images/*
  Cache-Control: public, max-age=604800

# Security headers for all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.google-analytics.com https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; connect-src 'self' https://www.google-analytics.com https://firebase.googleapis.com https://*.firebaseio.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.google.com; frame-ancestors 'none';
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
